# ==========================================================
# WAREHOUSE BACKEND - ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. NEVER commit .env.
# ==========================================================

NODE_ENV=development
PORT=4000

# --- Database (own dedicated DB, least-privilege user) ---
MONGODB_URI=mongodb+srv://warehouse_app_user:CHANGE_ME@cluster.mongodb.net/silk_warehouse?retryWrites=true&w=majority

# --- Sessions / cookies ---
SESSION_SECRET=CHANGE_ME_64_char_random_string
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME=wh_sid
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- OTP ---
OTP_SECRET=CHANGE_ME_random_string
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LOCKOUT_MINUTES=15

# --- Cloudinary (signed uploads only, secret never sent to browser) ---
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER_ROOT=warehouse/products

# --- Providers ---
EMAIL_PROVIDER_API_KEY=CHANGE_ME
SMS_PROVIDER_API_KEY=CHANGE_ME

# --- Integration API (for the FUTURE selling website only) ---
INTEGRATION_SECRET=CHANGE_ME_separate_from_admin_credentials
INTEGRATION_RATE_LIMIT_PER_MIN=60

# --- CORS ---
WAREHOUSE_FRONTEND_ORIGIN=http://localhost:3000

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_15MIN=10
OTP_RATE_LIMIT_PER_15MIN=5
ADMIN_RATE_LIMIT_PER_MIN=120
